{
    "name": "stechstudio/laravel-uppy-companion",
    "description": "Reusable set of routes to sign and manage S3 multipart uploads with Uppy.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "STS\\LaravelUppyCompanion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "STS\\LaravelUppyCompanion\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "David Palmer",
            "email": "dp@reproconnect.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.111",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "STS\\LaravelUppyCompanion\\LaravelUppyCompanionServiceProvider"
            ]
        }
    }
}
